# === Required ===

# Your domain (DNS must point to this server)
PAPERCLIP_DOMAIN=paperclip.npm-agent.com

# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Generate with: openssl rand -base64 24 | tr -d '/+=' | head -c 32
POSTGRES_PASSWORD=

# === AI Agent Keys (at least one required for agents to work) ===

# Anthropic API key for Claude Code agents
ANTHROPIC_API_KEY=

# OpenAI API key for Codex agents
OPENAI_API_KEY=

# GitHub token used by the deploy-watcher to read production-deployment status
# (requires repo / deployments read scope)
GITHUB_TOKEN=

# === Optional ===

# POSTGRES_USER=paperclip
# POSTGRES_DB=paperclip
